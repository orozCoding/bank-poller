SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

BANK_NAME=Banco receptor
BANK_LOGIN_URL=https://tu-banco.com/login
BANK_MOVEMENTS_URL=https://tu-banco.com/movimientos
BANK_USERNAME=
BANK_PASSWORD=

# Browser/session
HEADLESS=false
BROWSER_CHANNEL=chrome

# Polling
POLL_INTERVAL_SECONDS=180
POLL_JITTER_SECONDS=90
BANK_ROWS_LIMIT=20
MAX_SEEN_MOVEMENTS=5000

# Required scraping selector
BANK_ROWS_SELECTOR=table tbody tr

# Optional field selectors inside each row
BANK_DATE_SELECTOR=.date
BANK_REFERENCE_SELECTOR=.reference
BANK_AMOUNT_SELECTOR=.amount
BANK_DESCRIPTION_SELECTOR=.description

# Optional session/login selectors
BANK_USERNAME_SELECTOR=input[name="username"]
BANK_PASSWORD_SELECTOR=input[name="password"]
BANK_SUBMIT_SELECTOR=button[type="submit"]
BANK_LOGGED_IN_SELECTOR=.account-menu
BANK_SESSION_EXPIRED_SELECTOR=.session-expired
BANK_SESSION_EXPIRED_TEXT=

# Optional tuning
BANK_REFRESH_SELECTOR=
POLL_TIMEOUT_MS=30000
POST_LOGIN_WAIT_MS=5000
SAVE_DEBUG_ARTIFACTS=true
