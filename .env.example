# Required for live notifications
SLACK_BOT_TOKEN=xoxb-xxxxxxxx
SLACK_CHANNEL=#pagos-clientes
# Post a "still alive" heartbeat after every successful check (edited in place)
# even when there are no new payments. Set to false to only notify on payments.
SLACK_HEARTBEAT=true
# Timezone for the "last checked" timestamp in the heartbeat.
TIMEZONE=America/Caracas

# Required when the session expires and the poller needs to log in again.
BANK_USERNAME=
BANK_PASSWORD=

# Optional tuning overrides. The repo already defaults to Banco de Venezuela.
HEADLESS=false
BROWSER_CHANNEL=chrome
# Poll every 15-20 min: interval +/- jitter, randomized so the cadence isn't
# robotic. At this spacing the portal session always lapses between polls, so
# every cycle re-authenticates (~70s) instead of reusing a session.
POLL_INTERVAL_SECONDS=1050
POLL_JITTER_SECONDS=150
POLL_MAX_BACKOFF_SECONDS=1800
BANK_ROWS_LIMIT=20
MAX_SEEN_MOVEMENTS=5000
NOTIFY_ONLY_INCOMING=true
REFERENCE_SUFFIX_LENGTH=6
# BDV sits behind a Radware anti-bot layer that can delay page loads ~60s;
# keep this generous so a slow load doesn't fail a whole cycle. Note this does
# NOT cover the blank-page failure (Angular never boots, so no timeout helps) —
# the in-cycle retry in index.js is what recovers from that.
POLL_TIMEOUT_MS=180000
POST_LOGIN_WAIT_MS=5000
SAVE_DEBUG_ARTIFACTS=true

# Inspect mode
BANK_INSPECT_URL=
INSPECT_WAIT_MS=15000

# Optional advanced overrides. Leave blank unless the BDV UI changes.
BANK_LOGIN_URL=
BANK_MOVEMENTS_URL=
BANK_ROWS_SELECTOR=
BANK_DATE_SELECTOR=
BANK_REFERENCE_SELECTOR=
BANK_DESCRIPTION_SELECTOR=
BANK_DIRECTION_SELECTOR=
BANK_AMOUNT_SELECTOR=
BANK_BALANCE_SELECTOR=
BANK_USERNAME_SELECTOR=
BANK_PASSWORD_SELECTOR=
BANK_SUBMIT_SELECTOR=
BANK_LOGGED_IN_SELECTOR=
BANK_SESSION_EXPIRED_SELECTOR=
BANK_SESSION_EXPIRED_TEXT=
BANK_REFRESH_SELECTOR=
BANK_MOVEMENTS_TRIGGER_SELECTOR=
BANK_LOGOUT_SELECTOR=
